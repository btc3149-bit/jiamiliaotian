{
	"name": "加米辽田",
	"short_name": "加米辽田",
	"description": "True end-to-end encrypted chat. Zero-knowledge, no database, server only relays ciphertext.",
	"lang": "zh-CN",
	"start_url": "./",
	"scope": "./",
	"display": "standalone",
	"orientation": "any",
	"background_color": "#357ae8",
	"theme_color": "#357ae8",
	"categories": ["social", "communication"],
	"share_target": {
		"action": "./share-target",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url",
			"files": [
				{ "name": "files", "accept": ["image/*", "text/plain"] }
			]
		}
	},
	"screenshots": [
		{ "src": "screenshots/placeholder-wide.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Placeholder — real screenshots pending (see docs/images/)" },
		{ "src": "screenshots/placeholder-narrow.png", "sizes": "720x1280", "type": "image/png", "form_factor": "narrow", "label": "Placeholder — real screenshots pending (see docs/images/)" }
	],
	"shortcuts": [
		{
			"name": "打开加米辽田 / Open Jiamiliaotian",
			"short_name": "加米辽田",
			"description": "Open the app and enter a room",
			"url": "./",
			"icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
		}
	],
	"icons": [
		{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{ "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
	]
}
