{
	"name": "加米辽田",
	"short_name": "加米辽田",
	"description": "True end-to-end encrypted chat. Zero-knowledge, no database, server only relays ciphertext.",
	"lang": "zh-CN",
	"start_url": "./",
	"scope": "./",
	"display": "standalone",
	"orientation": "any",
	"background_color": "#357ae8",
	"theme_color": "#357ae8",
	"categories": ["social", "communication"],
	"share_target": {
		"action": "./share-target",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url",
			"files": [
				{ "name": "files", "accept": ["image/*", "text/plain"] }
			]
		}
	},
	"icons": [
		{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{ "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
	]
}
